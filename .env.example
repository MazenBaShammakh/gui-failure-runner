OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=...
GOOGLE_API_KEY=...

# --- Agent S model routing (read by agents/agent_s/runner.py) ---
# Route both the planner (reasoning) and grounding engines to Gemini.
# NOTE: the planner *model* itself comes from --model (registry default "gpt-4o"),
# so also pass `--model gemini-3.5-flash` to make the planner Gemini too —
# AGENT_S_PROVIDER only selects the planner's provider/engine, not its model.
AGENT_S_PROVIDER=openai
GROUND_PROVIDER=gemini
GROUND_MODEL=gemini-2.5-pro
# gui_agents' "gemini" engine is OpenAI-compatible, so it needs an endpoint URL.
# Set it once here and leave MODEL_URL/GROUND_URL empty: an empty GROUND_URL keeps
# the runner on the API-grounding path, where grounding image dims auto-derive from
# the scaled screenshot (correct coord mapping). A non-empty GROUND_URL would switch
# it to the served UI-TARS path and force 1920x1080, breaking coordinates.
GEMINI_ENDPOINT_URL=https://generativelanguage.googleapis.com/v1beta/openai/
MODEL_URL=
GROUND_URL=

# PC-Agent OCR mode only (PC_AGENT_USE_PERCEPTION_INFO=1) — not needed by default
OCR_SERVER_ADDRESS=http://localhost:8000

# Mobilerun device (optional — defaults to first connected device)
ANDROID_DEVICE_ID=

# Notion sync (scripts/notion/sync_tasks.py --apply)
# Internal integration token from https://www.notion.so/my-integrations,
# with the Tasks database shared to that integration.
NOTION_TOKEN=
